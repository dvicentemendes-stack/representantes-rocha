.hero p{margin:0;font-size:17px;max-width:46ch;color:#FFE3E7}
main{max-width:640px;margin:-56px auto 0;padding:0 16px 56px;position:relative;z-index:2}
.search{background:var(--card);border-radius:18px;padding:10px;box-shadow:0 18px 40px -18px rgba(90,0,15,.45);display:flex;align-items:center;gap:10px}
.search svg{flex:none;margin-left:12px;color:var(--red)}
.search input{flex:1;min-width:0;border:0;outline:0;font:500 18px "DM Sans",system-ui,sans-serif;color:var(--ink);padding:12px 8px;background:transparent}
.search input::placeholder{color:#A8969A}
.search:focus-within{box-shadow:0 0 0 3px rgba(228,3,46,.35),0 18px 40px -18px rgba(90,0,15,.45)}
.hint{margin:14px 4px 0;font-size:14px;color:var(--muted)}
#results{margin-top:18px;display:grid;gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;display:grid;grid-template-columns:auto 1fr;gap:4px 14px;align-items:center}
.avatar{grid-row:1/span 4;width:48px;height:48px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;font:800 22px "Baloo 2",sans-serif}
.city{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.city h2{margin:0;font:700 19px/1.2 "Baloo 2","DM Sans",sans-serif}
.uf{font-size:12px;font-weight:700;color:var(--red-dark);background:#FDE7EB;border-radius:6px;padding:1px 7px}
.rep{margin:0;font-size:15px;color:var(--muted)}
.rep b{color:var(--ink);font-weight:700}
.tel{margin:0;font:700 17px "DM Sans",sans-serif;font-variant-numeric:tabular-nums}
.tel a{color:var(--ink);text-decoration:none}
.tel a:hover{color:var(--red-dark);text-decoration:underline}
.note{grid-column:2/-1;margin:0;font-size:13px;color:#8A6D00;background:#FFF6D6;border-radius:6px;padding:3px 8px;width:fit-content}
.wa{grid-column:1/-1;margin-top:10px;display:flex;align-items:center;justify-content:center;gap:8px;background:var(--wa);color:#fff;text-decoration:none;font-weight:700;font-size:15px;padding:12px 16px;border-radius:10px}
.wa:hover{background:#188a45}
.wa:focus-visible,.search input:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
.wa.off{background:#EFE7E8;color:var(--muted);font-weight:500}
.empty{text-align:center;color:var(--muted);padding:26px 8px;font-size:15px}
footer{text-align:center;color:var(--muted);font-size:13px;padding:0 16px 32px}
@media (prefers-reduced-motion:no-preference){.card{animation:in .22s ease-out}@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}}
@media (min-width:520px){.card{grid-template-columns:auto 1fr auto}.wa{margin:0;grid-row:1/span 4;grid-column:3}}
</style>
</head>
