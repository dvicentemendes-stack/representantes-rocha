.hero{position:relative;overflow:hidden;background:var(--red);color:#fff;padding:44px 20px 92px}
.hero::after{content:"";position:absolute;right:-70px;bottom:-90px;width:420px;height:420px;background:url(data:image/png;base64,) center/contain no-repeat;filter:brightness(0);opacity:.09;pointer-events:none}
.hero .in{position:relative;z-index:1;max-width:640px;margin:0 auto}
