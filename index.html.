function card(uf,cidade,rep,tel,rev){
  const mm=rep.match(/^([^(]+?)\s*(?:\((.+)\))?$/),nome=mm?mm[1]:rep,emp=mm&&mm[2]?mm[2]:"";
  const num=tel.replace(/\D/g,"");
  const btn=num?`<a class="wa" href="https://wa.me/${num}" target="_blank" rel="noopener">${WA} Chamar no WhatsApp</a>`:`<span class="wa off">Contato em breve</span>`;
  return `<article class="card"><div class="avatar" aria-hidden="true">${esc(nome[0].toUpperCase())}</div>
    <div class="city"><h2>${esc(cidade)}</h2><span class="uf">${uf}</span></div>
