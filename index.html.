body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}
header.top{background:#fff;border-bottom:1px solid var(--line);padding:18px 20px;display:flex;justify-content:center}
